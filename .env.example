# Loopback is mandatory and revalidated by the application.
ZIE_HOST=127.0.0.1
ZIE_PORT=8765
ZIE_AUTH_TOKEN=
ZIE_SIMULATOR=false
ZIE_LOG_PATH=runtime/zie.log.jsonl

# Executable implementing hermes-plugin/PROTOCOL.md. Keep Hermes/OAuth secrets in Hermes.
ZIE_HERMES_COMMAND=
ZIE_HERMES_SESSION=zie-command-center
ZIE_HERMES_MAIN_MODEL=openai-codex/gpt-5.6-sol

# One public voice selection shared by both providers.
ZIE_VOICE_ID=zie-default
ZIE_ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_API_KEY=
ZIE_VOICE_FALLBACK_COMMAND=

ZIE_CAMOFOX_ENABLED=false
ZIE_CAMOFOX_COMMAND=camofox
